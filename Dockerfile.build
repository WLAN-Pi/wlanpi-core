# Dockerfile.build [--build-arg SUITE=bullseye|bookworm|trixie]: builder image that runs dpkg-buildpackage on /work (default trixie)

ARG SUITE=trixie

FROM debian:${SUITE}

# No Rust toolchain: cryptography installs from prebuilt wheels (requirements.txt).

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    build-essential \
    debhelper \
    dh-python \
    dh-virtualenv \
    python3 \
    python3-dev \
    python3-setuptools \
    python3-venv \
    dbus \
    libdbus-1-dev \
    libdbus-glib-1-dev \
    libffi-dev \
    libssl-dev \
    pkg-config \
    devscripts \
    equivs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work

ENV WLANPI_CORE_HOME_DIR="/root"

CMD ["dpkg-buildpackage", "-us", "-uc", "-b"]
