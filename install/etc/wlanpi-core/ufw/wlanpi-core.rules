[wlanpi-core]
title=wlanpi-core API server with custom port
description=wlanpi-core API server
ports=31415/udp|31415/tcp

[wlanpi-webui]
title=wlanpi-webui server with HTTP + HTTPS
description=wlanpi-webui server
ports=80,443,8081/tcp

[wlanpi-core-tls]
title=wlanpi-core API server over HTTPS
description=wlanpi-core API HTTPS front-end (enable with wlanpi-core-tls enable api)
ports=31416/tcp

[wlanpi-mcp-tls]
title=wlanpi-mcp over HTTPS
description=wlanpi-mcp HTTPS front-end (enable with wlanpi-core-tls enable mcp)
ports=8767/tcp
