#!/bin/bash
# see: dh_installdeb(1)
# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

CONF_CHANGED=0

set -e

function isValidSymlink() {
    if [ -L "$1" ]; then
        return 0
    else
        return 1
    fi
}

if systemctl is-masked var-log-wlanpi_core-debug.mount >/dev/null 2>&1; then
    echo "Unmasking var-log-wlanpi_core-debug.mount..."
    systemctl unmask var-log-wlanpi_core-debug.mount || true
fi

if ! command -v python3 >/dev/null 2>&1; then
    echo "Error: python3 not found" >&2
    exit 1
fi

if ! PYTHONSTUB=$(python3 -V 2>&1 | sed 's/ //g' | grep -oP '(\w+\.\d+)' | tr 'P' 'p'); then
    echo "Error: Failed to determine Python version" >&2
    exit 1
fi

if [ -z "$PYTHONSTUB" ]; then
    echo "Error: Could not parse Python version" >&2
    exit 1
fi

# the actual target working directory (this is a workaround so we can support multiple Python versions at build)
TARGET_DIR=/opt/wlanpi-core/lib/$PYTHONSTUB/site-packages/wlanpi_core

# this is the parent directory which holds our linked working directory
LINK=/opt/wlanpi-core/workingdirectory

# this is the path that we need to check if is already a link
TEST_PATH=/opt/wlanpi-core/workingdirectory/wlanpi_core

# if link doesn't exist, create it
if ! isValidSymlink $TEST_PATH; then
    ln -sf "$TARGET_DIR" "$LINK"
fi

# if conf is not a symlink, and exists as a file, create backup.
NGINX_CONF=/etc/nginx/nginx.conf
if ! isValidSymlink $NGINX_CONF; then
    if [ -f "$NGINX_CONF" ]; then
        TSTAMP=$(date '+%s')
        NEW_CONF="$NGINX_CONF.$TSTAMP"
        echo "Existing nginx.conf detected; backing it up and moving it to $NEW_CONF..."
        mv "$NGINX_CONF" "$NEW_CONF"
    fi
    echo "Linking our nginx.conf config ..."
    ln -s /etc/wlanpi-core/nginx/nginx.conf $NGINX_CONF
    CONF_CHANGED=1
fi

# if default site is enabled, disable it.
DEFAULT_FILE=/etc/nginx/sites-enabled/default
if isValidSymlink $DEFAULT_FILE; then
    echo "Unlinking $DEFAULT_FILE"
    unlink $DEFAULT_FILE
fi

# Skip cert generation inside image-build chroots: the ischroot guard on service
# restart/UFW below already prevents service actions, but without this guard
# every image built in a chroot ships with an identical private key — any holder
# of one image can impersonate or decrypt traffic for all devices from that image.
# On first real boot the block runs as normal and generates a unique key per device.
if ! ischroot; then
    # Generate per-device TLS certs (nginx, webui, cockpit, grafana), covering
    # the renamed .local hostname. Regenerates when an existing cert predates it.
    CERT_MTIME_BEFORE=$(stat -c %Y /etc/nginx/ssl/self-signed-wlanpi.cert 2>/dev/null || echo 0)
    /etc/wlanpi-core/scripts/wlanpi-generate-certs.sh
    CERT_MTIME_AFTER=$(stat -c %Y /etc/nginx/ssl/self-signed-wlanpi.cert 2>/dev/null || echo 0)
    if [ "$CERT_MTIME_BEFORE" != "$CERT_MTIME_AFTER" ]; then
        CONF_CHANGED=0
    fi
fi

# Ensure nginx sites-enabled directory exists
mkdir -p /etc/nginx/sites-enabled

# if source configuration file exists, create symlink
WLANPI_CORE=/etc/nginx/sites-enabled/wlanpi_core.conf
SOURCE_CONF=/etc/wlanpi-core/nginx/sites-enabled/wlanpi_core.conf

if [ -f "$SOURCE_CONF" ]; then
    ln -sf "$SOURCE_CONF" "$WLANPI_CORE" || true
    CONF_CHANGED=1
else
    echo "Warning: source nginx site configuration at $SOURCE_CONF not found"
fi

if ! ischroot; then
    if [ $CONF_CHANGED -eq 1 ]; then
        echo "Restarting wlanpi-core ..."

        if ! deb-systemd-invoke start var-log-wlanpi_core-debug.mount; then
            echo "Warning: var-log-wlanpi_core-debug.mount failed to start" >&2
        fi
        if ! deb-systemd-invoke restart wlanpi-core.service; then
            echo "Warning: wlanpi-core.service restart failed, continuing installation..." >&2
            systemctl --no-pager status wlanpi-core.service >&2 || true
        fi
        if which nginx >/dev/null 2>&1; then
            echo "Validating nginx configuration..."
            nginx -t
            if systemctl is-active --quiet nginx.service; then
                echo "Reloading nginx..."
                deb-systemd-invoke reload nginx.service
            else
                echo "Starting nginx..."
                deb-systemd-invoke start nginx.service
            fi
        fi
    fi
fi

# if [ -f /usr/bin/getjwt ]; then
#     chmod 755 /usr/bin/getjwt
# fi

if [ -f /usr/bin/lhapitest ]; then
    chmod 755 /usr/bin/lhapitest
fi

if ! ischroot; then
    if [ -f /etc/wlanpi-core/ufw/wlanpi-core-ufw-rules-setup.sh ]; then
        /etc/wlanpi-core/ufw/wlanpi-core-ufw-rules-setup.sh
    fi
fi

# Our lldpd drop-in enables CDP reception; reload and restart lldpd so it
# takes effect (lldpd's own maintainer scripts won't pick up our drop-in).
if ! ischroot; then
    systemctl daemon-reload || true
    if systemctl is-enabled lldpd.service >/dev/null 2>&1; then
        deb-systemd-invoke restart lldpd.service || true
    fi
fi

exit 0
