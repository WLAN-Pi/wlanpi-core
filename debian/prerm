#!/bin/sh
set -e

case "$1" in
    remove|upgrade|deconfigure)
        if [ -d /run/systemd/system ]; then
            deb-systemd-invoke stop wlanpi-core.socket wlanpi-core.service || true
        fi
        if systemctl is-active var-log-wlanpi_core-debug.mount >/dev/null 2>&1; then
            systemctl stop var-log-wlanpi_core-debug.mount || true
        fi
        if mountpoint -q /var/log/wlanpi_core/debug; then
            umount -l -f /var/log/wlanpi_core/debug || true
        fi
    ;;
    failed-upgrade)
    ;;
    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

#DEBHELPER#

exit 0
